# AI Hedge Fund Environment Variables
# Copy this file to .env and update the values

# Required: Gemini API Key for LLM functionality
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: News API for enhanced sentiment analysis
# NEWS_API_KEY=your_news_api_key_here

# Optional: Additional data sources
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
FRED_API_KEY=
QUANDL_API_KEY=

# Logging Configuration
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/ai_hedge_fund.log

# Analysis Configuration
MAX_CONCURRENT_REQUESTS=10
CACHE_DURATION=3600  # seconds

# Risk Management Rules
MAX_POSITION_SIZE=0.10  # 10% of portfolio per position
STOP_LOSS_PCT=0.08  # 8% stop loss
TAKE_PROFIT_PCT=0.20  # 20% take profit
MAX_SECTOR_ALLOCATION=0.25  # 25% per sector

# LLM Settings
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000
